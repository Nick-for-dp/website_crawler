# DeepSeek API Key（大模型归纳简报用），申请地址: https://platform.deepseek.com/
deepseek_api_key=

# 【可选】服务器无法访问 api.deepseek.com 时，切换国内可达的 OpenAI 兼容端点：
#   火山方舟: llm_base_url=https://ark.cn-beijing.volces.com/api/v3/chat/completions
#   阿里云百炼: llm_base_url=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# llm_base_url=    # 默认 https://api.deepseek.com/chat/completions
# llm_model=       # 默认 deepseek-chat；火山方舟填模型ID或接入点ID，百炼填如 deepseek-v3
# llm_api_key=     # 非 DeepSeek 厂商的 Key；不填则复用上面的 deepseek_api_key

# 钉钉群自定义机器人 webhook（群设置 → 智能群助手 → 添加机器人 → 自定义）
dingding_webhook=

# 钉钉机器人加签密钥（安全设置选择"加签"，以 SEC 开头的字符串）
dingding_secret=
